DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
MCP_API_KEY="your-secret-mcp-bearer-token"
GEMINI_MODEL="gemini-2.5-flash"
GOOGLE_GENERATIVE_AI_API_KEY="your-google-ai-studio-api-key"
CRON_SECRET="your-cron-bearer-secret"
# Optional: HMAC key for signed workspace cookies (32+ chars). If unset, a key
# is derived from MCP_API_KEY. Set it explicitly in production.
SESSION_SECRET="replace-with-at-least-32-random-characters"
# Optional: canonical public URL. On Vercel the platform URL variables are used.
APP_URL="http://localhost:3000"
# Sign-in providers (OAuth apps). Callback paths: /api/auth/google/callback and /api/auth/github/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
